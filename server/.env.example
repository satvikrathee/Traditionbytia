# ==========================================
# TRADITIONS BY TIYA - BACKEND CONFIGURATION
# ==========================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection String
# Enable replica set on MongoDB Atlas to utilize real-time Change Streams
MONGODB_URI=mongodb://127.0.0.1:27017/traditions_by_tiya

# JWT Secret for Session Authentication
JWT_SECRET=traditions_by_tiya_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Cloudinary (Image Storage & Optimization)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payments (UPI & Webhooks)
# Test keys format: rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Nodemailer / SMTP (Gmail App Password or Resend SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Traditions By Tiya" <orders@traditionsbytiya.com>

# Google OAuth 2.0 Client ID (for Google Sign-In)
GOOGLE_CLIENT_ID=

